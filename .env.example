# ==============================================================================
# Flash Automator CLI: KDMC MyNet HTTP Report Automation Configuration
# ==============================================================================

# Target Application Base URLs
KDMC_BASE_URL=https://kdmc.gov.in/MainetService
KDMC_BIRT_OUTPUT_URL=https://kdmc.gov.in/birtPA/output

# Authorized session cookie (JSESSIONID) extracted from browser DevTools after logging in.
# WARNING: Keep this confidential. Never commit real session cookies to Git.
KDMC_SESSION_COOKIE=NxHlFACfkk6RHEH4Xj4Vsr0KnncQQYi4MUvCmT2S.skdcl-app-02; accessibility=M; Webportal=WebPortal-2-80

# Optional CSRF token override (the automation will automatically harvest/refresh if omitted)
# KDMC_CSRF_TOKEN=your_csrf_token_here

# Municipal Defaults (HO Main Branch enforced across all reports)
KDMC_REPORT_TYPE=BAS
KDMC_FIELD_ID=4
KDMC_ACCOUNT_HEAD_ID=0
KDMC_ULB_NAME=1
KDMC_WARD=4
KDMC_BANK=0
KDMC_MODE=X
KDMC_PAYMENT_MODE=0

# Rate Limiting & Politeness (Seconds between sequential requests)
KDMC_REQUEST_DELAY=1.5

# HTTP Timeouts & Network Resiliency
KDMC_CONNECT_TIMEOUT=10.0
KDMC_READ_TIMEOUT=30.0
KDMC_MAX_RETRIES=3
KDMC_RETRY_BACKOFF=1.5

# Output Paths
KDMC_OUTPUT_DIR=./output
KDMC_DEBUG_DIR=./debug
KDMC_SAVE_HTML=false
